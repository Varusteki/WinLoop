<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Per-Monitor V2 DPI 感知：修复 125%/150% 缩放下的坐标错位 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 图标分两套（2026-09-20 最终形态）：
       - appIcon.ico  → ApplicationIcon（exe 图标）+ App.xaml 的 AppIcon 资源
                        档位 16/20/24/32/40/48/64/96/128/256（10 档，覆盖 100%~400% 缩放）
       - trayIcon.ico → 托盘图标（WPF Resource）：App.xaml.cs 通过 pack URI 引用
                        档位 16/20/24/32/48（托盘实际只用这几档，多余档位白占体积）

       两套**图形完全相同**（完整三层：圆环 + 八角星 + 骷髅）、**底色也相同**
       （中蓝 #0F6CBD 圆角矩形铺满画布），只有尺寸档位不同。
       底色为什么必须是「中等亮度饱和色」：图形本体只有黑(53%)/白(43%)/金(2%) 三色，
       底色要同时与黑、白都拉开对比度，相对亮度 L 必须落在 [0.10, 0.30] ——
       任何灰度色（含浅灰、深灰）天生不合格，只能满足一边。详见 make_icons.py 顶部注释。

       两者由 Tools/IconGen 渲染、probe-out/icon/make_icons.py 合成。 -->
  <PropertyGroup>
    <ApplicationIcon>Resources\appIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 托盘图标：App.xaml.cs 通过 pack URI 引用 -->
    <Resource Include="Resources\trayIcon.ico" />
    <!-- 应用图标：供 ApplicationIcon 与 App.xaml 的 AppIcon 资源使用 -->
    <Resource Include="Resources\appIcon.ico" />
    <!-- Include skull XAML resource -->
    <Resource Include="Resources\skull.xaml" />

    <!-- ==================== 内嵌字体 ====================
         界面字体随包分发，保证在任何机器上渲染一致。
         只引字体名（如 "Noto Sans SC"）是不够的 —— 目标机没装该字体时
         WPF 会静默回退到微软雅黑，字间距和标题层级全部走形，而且不报错。
         打成 Resource 后用 pack:// URI 引用，见 App.xaml 的 UiFontFamily。

         只带两个静态字重：
           - Regular  → FontWeight="Normal"（正文）
           - Medium   → FontWeight="SemiBold"（标题/选中态）
         Bold 在界面里没有任何引用处，不带，省 8.5MB。

         注：不用 /c/Windows/Fonts/NotoSansSC-VF.ttf（可变字体）。
         WPF 对 OpenType 可变字体的字重轴支持不可靠，SemiBold 很可能
         被忽略而退化成 Regular —— 那标题和正文就分不出来了。 -->
    <Resource Include="Resources\Fonts\NotoSansSC-Regular.otf" />
    <Resource Include="Resources\Fonts\NotoSansSC-Medium.otf" />

    <!-- XuanKongSi default images -->
    <Content Include="Resources\XuanKongSi\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>