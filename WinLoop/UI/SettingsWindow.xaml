<Window x:Class="WinLoop.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinLoop.UI"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="WinLoop 设置"
        Width="880" Height="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontSize="14" FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 把 "#RRGGBB" 字符串转成 Brush，供色块按钮的填充色绑定。
             绑定不会自动走类型转换器，必须显式转一次；
             转不出来（用户敲了半截）就退回透明，不要抛异常砸掉整个界面。 -->
        <local:HexToBrushConverter x:Key="HexToBrush"/>
        <!-- ==================== 设计令牌 ====================
             跟随 Windows 浅色主题取色，集中在这里定义：改配色只改这一段，全局生效。
             原先散落在各处的 #FFE3E3E3 / #FFF7F7F7 / #FF444444 / #888 全部收敛到这里。 -->

        <!-- 底色层次：窗口 > 导航区 > 卡片
             参照 PixPin：导航底色比内容区**更浅**（#F7F7F7 vs #F5F5F5），
             靠"更亮"而不是"更深"来区分区域，视觉上更透气。 -->
        <SolidColorBrush x:Key="WindowBg"      Color="#FFF5F5F5"/>
        <SolidColorBrush x:Key="NavBg"         Color="#FFFAFAFA"/>
        <SolidColorBrush x:Key="CardBg"        Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="FooterBg"      Color="#FFF5F5F5"/>

        <!-- 表单行的分隔线：PixPin 那种"整齐感"主要来自这条线 -->
        <SolidColorBrush x:Key="RowLine"       Color="#FFEDEDED"/>
        <!-- 导航选中态实心块 -->
        <SolidColorBrush x:Key="NavActiveBg"   Color="#FF0F6CBD"/>
        <SolidColorBrush x:Key="NavHoverBg"    Color="#FFEFEFEF"/>

        <!-- 描边：卡片 / 分隔线 / 输入框 -->
        <SolidColorBrush x:Key="LineEdge"       Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="LineSoft"       Color="#FFE8E8E8"/>
        <SolidColorBrush x:Key="InputEdge"      Color="#FFC8C8C8"/>
        <SolidColorBrush x:Key="InputEdgeHot"   Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="InputEdgeOn"    Color="#FF0F6CBD"/>

        <!-- 文字：主 / 次 / 弱 -->
        <SolidColorBrush x:Key="TextMain"      Color="#FF1B1B1B"/>
        <SolidColorBrush x:Key="TextSub"       Color="#FF5A5A5A"/>
        <SolidColorBrush x:Key="TextFaint"     Color="#FF8A8A8A"/>

        <!-- 强调色（Windows 11 系统蓝） -->
        <SolidColorBrush x:Key="Accent"        Color="#FF0F6CBD"/>
        <SolidColorBrush x:Key="AccentHot"     Color="#FF1A7AD1"/>
        <SolidColorBrush x:Key="AccentDown"    Color="#FF0B5AA0"/>
        <SolidColorBrush x:Key="AccentSoft"    Color="#FFE8F1FB"/>

        <!-- 间距令牌（四档） -->
        <sys:Double x:Key="GapXs">4</sys:Double>
        <sys:Double x:Key="GapSm">8</sys:Double>
        <sys:Double x:Key="GapMd">12</sys:Double>
        <sys:Double x:Key="GapLg">20</sys:Double>

        <!-- 表单栅格：标签列与输入列统一宽度，输入框不再左右参差。
             ⚠️ 两类 token 不能混用：
               - Width 用在 TextBox/Border 等 FrameworkElement 上，类型是 double；
               - ColumnWidth 用在 ColumnDefinition.Width 上，类型是 GridLength。
             混用会在**运行时**抛 XamlParseException（编译期查不出来）。

             行高：控件本体 32 + 行内上下留白 8+8 = 行总高 48。
             字号从 13 提到 14 之后如果行高还是 44，文字在行内会顶得很满、
             看着"挤"；加高到 48 让文字四周留出呼吸空间，同时分割线间距更舒展。
             分割线画在行底，因此每行是"内容 32 + 边距 8+8"，线上的下一行重新开始计数。 -->
        <sys:Double x:Key="FormLabelW">96</sys:Double>
        <!-- 输入框统一宽度：所有 TextBox 用同一个值，行与行的输入框右边缘对齐，
             视觉上形成一条竖直的列。原先 84 太窄，四位数（1000）会贴着内边距，
             加到 100 让 4 位数也有余量。 -->
        <sys:Double x:Key="FormFieldW">100</sys:Double>
        <sys:Double x:Key="FormRowH">32</sys:Double>
        <sys:Double x:Key="FormRowPadV">8</sys:Double>
        <GridLength x:Key="FormLabelCol">108</GridLength>
        <!-- 行流模板：标签固定宽 → 控件列 → 剩余（说明文字/弹性空间） -->
        <GridLength x:Key="FormFieldCol">Auto</GridLength>

        <!-- ==================== 文字 ====================

             ⚠️ "文字飘在半空"的根因（本轮修复）：
             标签列的 ColumnDefinition 宽度是 108（FormLabelCol），而视觉上
             文字只占 40~60px，右边留出 50~70px 空白 —— 于是标签、输入框、
             单位说明三者被拉成一条稀疏的横排，眼睛找不到对齐锚点。
             修复分两步：① 标签列收窄 + 输入框紧贴标签（栅格本身更紧凑）；
             ② FontSize 13→14、行高 30→32，让文字**有实体感**不再像浮标。 -->

        <!-- 表单行标签：左对齐，垂直居中于行内。行间距由行的 Padding 控制，
             这里不再自带上下 Margin（否则行高会失控）。
             Foreground 用 TextMain 而非 TextSub —— 标签是行的"主信息"，
             原先用次级灰导致整行视觉焦点落在右侧输入框上，重心右偏。 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <!-- 卡片内的小标题（"尺寸" / "配色" 这类分组名） -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 弱化说明文字（尺寸单位、换算结果等） -->
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 行内右侧的说明文字：垂直居中在控件同一水平线上 -->
        <Style x:Key="RowHintStyle" TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <!-- 独立的页面标题（每页顶部一行，位于白卡**之外**，参照 PixPin）。
             15→17：页标题是这一屏最大的字，和 14 的正文拉开一级落差，
             层级才立得住（原先 15 vs 13 只差 2px，几乎看不出主次）。 -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- ==================== 行流 ====================
             重构核心：整页由若干等高"行"堆叠而成，行与行之间夹一条 1px 淡分割线。
             PixPin 的整齐感就来自这套节奏 —— 整齐 > 花哨。
             用法：把 SettingRow 当 Grid 用，行内自加列定义。 -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="{StaticResource FormRowH}"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>

        <!-- 行间分割线：左右各内缩 1px，避免和卡片边框贴死 -->
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource RowLine}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ==================== 输入控件 ====================

             ⚠️ Width 直接写在 InputStyle 里，而不是让每个 TextBox 自己指定。
             这样"所有输入框尺寸一致"是**结构上成立**的，不是靠人工逐个对齐 ——
             以后新增输入框只要套 InputStyle 就自动同宽，不会漏。
             Markdown 编辑器那种需要撑满整行的大编辑框走 InputFillStyle。 -->

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="{StaticResource FormFieldW}"/>
            <Setter Property="Height" Value="{StaticResource FormRowH}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputEdgeHot}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputEdgeOn}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 多行编辑框：撑满可用宽度、高度自定，不走 FormFieldW。
             用于悬空寺的 Markdown 编辑器这类"整块内容区"。 -->
        <Style x:Key="InputFillStyle" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- ⚠️ 原先这里写了 Margin="0,6"。行距现在统一由 SettingRow 的 Margin 控制，
             样式里再带 Margin 会让"控件高度 + 双重外边距"叠加，
             在行高较紧的地方（如操作配置页）直接把下方提示文字顶到重叠。
             行内一律不给控件加外边距。 -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="{StaticResource FormRowH}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <!-- ==================== 容器 ====================

             ⚠️ 卡片内边距 22,18（原 20,16）：配合行高 32 + 字号 14，
             内容四周留出更宽的余量。卡片是"页面里的一张纸"，
             纸的留白不够，里面的字就会像贴着边线跑。 -->

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 页内小分组标题：卡内换组时用。
             字号与 LabelStyle 同为 14，靠 SemiBold + 上下文留白做区分；
             底部留白 2→4，让它和紧跟其后的分割线之间透口气，不再贴死。 -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <!-- ==================== 操作配置页：选区行 ====================
             「操作配置」页是三栏结构：左列 4 行 + 中间菜单 + 右列 4 行，
             左右之间的对应关系用折线引线表达（引线由代码画在 OpConnectorLayer 上）。

             一个 Border 就是一行「选区 → 动作」。
             ⚠️ Background / BorderBrush 的初始值是 **Transparent 而不是缺省**：
             "当前选中哪一行"靠代码改这两个属性表达，透明保证未选中时没有可见色块；
             同时 1px 边框**始终占位**，选中时不会因为多出一条边而让行高抖一下。 -->
        <!-- 行距由这里统一给（行内控件一律不带外边距）：
             行高 = 边框 2 + 上下内边距 2×2 + 下拉框 **44** = **50**，行距取 **10**。
             ⚠️ 行高 / 行距 / 两列的竖直偏移都是**算出来的、不是手感**：
             ① 锚点 y 只由圆周位置定：位置1（正上）与位置5（正下）在菜单中心的 **±R**，
                R = 锚点环半径 = OpAnchorRingVisibleR(93) + OpAnchorGap(6) = **99**
                （四样式 99.0~99.4，见 UpdateOpConnectors 的 anchorR）。
                行心 y 与锚点 y 相等的那条引线没有台阶，退化成**一段水平直线**。
             ② 于是"要让哪两条变直"就是**唯一**的约束。用户 2026-09-22 定的目标是
                **左下（位置5＝左列第 4 行）与右上（位置1＝右列第 1 行）**。
                设行心间距 s = 行高 + 行距 = 60、列偏移 t，则
                    右列行心 = t + (−1.5s, −0.5s, +0.5s, +1.5s)
                    左列行心 = t + (−1.5s, −0.5s, +0.5s, +1.5s)      （左列第 4 行 = 位置5）
                反解：右列第1行 = −R → t_右 = 1.5s − R = **−9**（右列整体**上移 9**）
                      左列第4行 = ＋R → t_左 = R − 1.5s = **＋9**（左列整体**下移 9**）
                结果四行行心（负=上）：
                    右列  −99 / −39 / +21 / +81        左列  −81 / −21 / +39 / +99
                位置1 行心 −99 = 锚点 −99 ✓、位置5 行心 +99 = 锚点 +99 ✓ → 两条各只剩一段直线。
                ⚠️ **两列刻意错开 18px，不要"对齐"回去**：这是把这两条拉直的唯一解，
                用户明确说过"不需要保持左右控件的对齐"。
                ⚠️ 也不能靠"把行距加到 16"在对称布局下达成 —— 那版行组顶满画布（248/252）
                且同样只能改一对，用户已否掉。
             ③ 行组外沿**与行距无关**：最外行心恒为 ±R → 外沿 = ±(99 + 行半高 25) = **±124**，
                画布半高 126 → 恰好留 2px。所以行距可以自由选（这里回到 10：视觉舒适，
                两列错开后 4 行总高 230，画布还剩 22px）。
                想让那两条以外的线也变短，只能改 R（＝改菜单大小），不是改行距。
             ④ 下拉框 44 = 行高 50 − 上下留白 2×2 − 边框 2，即"框几乎填满行"。
                与引线无关（起点按框的侧边中点算，框多高都行）。
             横向内边距 8→4（2026-09-22）：引线起点按**下拉框**的朝内边缘算
                （不再按行边框，见 UpdateOpConnectors），4 的留白让起点离下拉框只剩 2px，
                选中态又还能在大框外露出一圈浅底。 -->
        <!-- ⚠️ Margin 只写 bottom（行距）时，**StackPanel 会把末尾那段行距也算进高度**：
             4 行 230 里最后那 10px 是"空的一段" → 行组整体上移 5px。
             两个 margin 都必须含"抵消末尾行距"的项（bottom = −10），再叠加整列偏移。
             精确算法（元素顶 = (H − h − top − bottom)/2 + top）：
                · 只抵消、不偏移       → top 0,  bottom −10  （基准，顶 = (H−h)/2 + 5）
                · bottom 每 +2 → 元素上移 1px；top 每 +2 → 元素下移 1px
                · 右列上移 9px → bottom = −10 + 18 = **+8**   → Margin="0,0,0,8"
                · 左列下移 9px → top = 0 + 18 = **18**        → Margin="0,18,0,-10"
             改行距或改偏移量都要**同步改这两个 Margin**（自检 ⑤d / ⑤f / ⑤g 三重兜底）。 -->
        <Style x:Key="OpRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ⚠️ 本页的下拉框**刻意比 FormRowH(32) 高**：44 = 行高 50 − 留白。
             2026-09-22 第四轮之前，这个高度是"引线起点沿行边缘滑动 ±21 时不许滑出框"
             的硬约束（44 = 2×(21+1)）；第四轮起点钉死在**框侧边中点**后这条约束消失了，
             44 变成纯外观选择（框填满整行）—— 所以本页 8 个框共用这个高度只是为了统一，
             改它不再影响引线，只要行高仍是 50（同步调 OpRowStyle 的上下内边距）。 -->
        <Style x:Key="OpComboStyle" TargetType="ComboBox" BasedOn="{StaticResource ComboStyle}">
            <Setter Property="Height" Value="44"/>
        </Style>

        <!-- ⚠️ 刻意**没有** OpRowTitleStyle：行内不再写「位置N · 方位」小字
             （2026-09-22 用户要求去掉）。行与扇区的对应完全由引线表达，
             再写一遍文字是重复信息，还会把行撑高、引线起点上下飘。
             代价是"哪一行是哪个位置"只剩引线一个凭据 —— 引线画不出来时就真的认不出，
             所以自检里那几条**方向角断言**是这页唯一的正确性保障，别删。 -->

        <!-- 引线的颜色。刻意**不复用** LineEdge（#E0E0E0）——
             引线是"要看清楚"的信息载体，不是背景装饰，用卡片描边那么淡的灰
             在白卡上几乎看不见（实测截图里要眯眼才分辨得出）。
             取值比首版（#CFCFCF）略深：反馈"不美观"的主因之一是线太淡、在白卡上发虚。 -->
        <SolidColorBrush x:Key="OpConnectorLine" Color="#FFC4C4C4"/>

        <!-- 卡片内的次级分隔块（不带外框，仅用于配色组这类子区域） -->
        <Style x:Key="SubSectionBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFCFCFC"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ==================== 左侧导航 ==================== -->
        <!-- 顶部标签改为左侧纵向导航：标签横向排列在 760 宽里本来就挤，
             挪到左侧后内容区更宽，四个页面也能共用同一套边距。 -->

        <!-- 参照 PixPin：选中态是**整块实心蓝 + 白字**，不是细竖条 + 淡蓝底。
             原因：左边栏只有 150px 宽，靠竖条暗示选中在窄栏里辨识太慢；
             实心块一眼就能定位当前位置，也省掉额外的视觉元素。

             34→36：字号提到 14 后，34 的行高让上下留白只剩 9px，
             实心蓝块显得"扁"。36 配 14 号字，块的高宽比更接近正方形感。 -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Margin="12,3">
                            <ContentPresenter Margin="12,0,12,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavActiveBg}"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== 按钮 ==================== -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHot}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHot}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDown}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDown}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFAFAFA"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputEdgeHot}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== 色块按钮 ====================
             参照 PixPin：按钮内部**左侧嵌一个 14×14 小色块**，右边跟文字"更改颜色"。
             原先的写法是"色块按钮"和"颜色文本框"两个等宽元素并排，占地方且不像工具。
             现在合成一个：用户看到的色块就是真实颜色，点整块即调色。

             色块的填充色**绑定到 Tag**，Tag 再绑到同行的文本框 Text，
             这样在文本框里粘贴 #RRGGBB 或走调色盘，色块都会立刻跟着变。
             ⚠️ 绑定不走类型转换器，string → Brush 必须显式用 HexToBrush。 -->

        <!-- 色块按钮：左侧 15×15 色块 + 右侧文字。
             两处填充色都**绑定到 Tag**，Tag 再绑到同行的隐藏文本框 Text，
             这样走取色器改色后，按钮上的色块与色值文字会一起实时更新。
             ⚠️ 绑定不走类型转换器，string → Brush 必须显式用 HexToBrush。

             按钮文字现在是**当前色值**（如 #EC2323），不是固定的"更改颜色"。
             宽度靠 MinWidth + Padding 撑住，7 位色值不会贴边。 -->
        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Height" Value="{StaticResource FormRowH}"/>
            <!-- ⚠️ 宽度必须和数字输入框用同一个令牌 FormFieldW。
                 之前写的是 MinWidth=146，与输入框的 100 不一致，
                 两类控件在同一列里右边缘对不齐 —— 视觉上很明显。
                 改成 FormWidth（Width，不是 MinWidth）：定宽才能保证对齐，
                 MinWidth 只设下限、内容撑长就又不齐了。 -->
            <Setter Property="Width" Value="{StaticResource FormFieldW}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="点击打开取色器"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource InputEdge}"
                                BorderThickness="1"
                                Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Name="Chip" Width="14" Height="14" CornerRadius="3"
                                        BorderBrush="#33000000" BorderThickness="1"
                                        Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag, Converter={StaticResource HexToBrush}}"/>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputEdgeHot}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF4F4F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部左侧的"恢复所有默认设置"：破坏性操作。
             参照 PixPin 的做法 —— 用淡红描边 + 红字，明确它是"危险"
             但不给它主按钮的视觉重量，避免误点。 -->
        <Style x:Key="DangerGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFE8B4B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="{StaticResource FormRowH}"/>
            <Setter Property="Foreground" Value="#FFC0382F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFDF2F2"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD08A8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFAE6E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 兼容旧引用：原 "..." 小按钮仍在别处使用 -->
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- 勾选项（开机启动 / 最小化到托盘 / 启用悬空寺）与
             单选组（样式选择：圆环/Headshot/蜘蛛网/八卦）共用一套视觉。

             ⚠️ 这里必须写**两份**样式，不能一份吃两家。
             WPF 对 `Style.TargetType` 的检查发生在**套用样式的那一刻**，
             不匹配就直接抛
               "设置属性 System.Windows.FrameworkElement.Style 时引发了异常"。
             它的报错只有这一句，既不说哪个 Style、也不说为什么，
             排查成本极高 —— 所以下面两处模板刻意保持逐字一致，
             改外观时**两个都要改**，别只动一个。

             另一条硬约束：ControlTemplate 必须匹配宿主控件的类型。
             不能把 CheckBox 的模板挂到 RadioButton 上（TargetType="CheckBox"
             的模板只能用于 CheckBox）—— 所以这里是复制而非复用。 -->
        <ControlTemplate x:Key="CheckGlyphTemplate" TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
                <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                        Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource InputEdge}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Path x:Name="Tick" Stretch="Uniform" Margin="3.5"
                          Stroke="#FFFFFFFF" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M 0,5 L 4,9 L 12,0" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InputEdgeHot}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                    <Setter TargetName="Box" Property="Background" Value="#FFF0F0F0"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template" Value="{StaticResource CheckGlyphTemplate}"/>
        </Style>

        <!-- 单选组：外观与勾选框一致，但 TargetType 必须是 RadioButton。
             模板内容与上面逐字相同（见上方说明，改动时两处同改）。 -->
        <ControlTemplate x:Key="RadioGlyphTemplate" TargetType="RadioButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
                <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                        Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource InputEdge}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Path x:Name="Tick" Stretch="Uniform" Margin="3.5"
                          Stroke="#FFFFFFFF" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M 0,5 L 4,9 L 12,0" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InputEdgeHot}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                    <Setter TargetName="Box" Property="Background" Value="#FFF0F0F0"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template" Value="{StaticResource RadioGlyphTemplate}"/>
        </Style>
    </Window.Resources>
    <!-- ==================== 窗口框架：左导航 + 右内容 + 底部操作栏 ====================
         原先把"保存/恢复默认"用 Panel.ZIndex="100" 浮在 TabControl 上方，
         会盖住标签栏；现在改为底部独立一行，加分隔线，不再遮挡。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- 150→168：导航字号提到 14 后，150 宽减去左右 12 的内缩只剩 126，
                     "菜单样式"四个字 + 内边距已经贴边。168 让实心块两侧各留 ~24px，
                     块内文字两侧各留 12px，视觉上才不局促。 -->
                <ColumnDefinition Width="168"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：参照 PixPin，窄栏 + 实心块选中。
                 顶部原先有一行 "WinLoop" 应用名，已按需求移除 ——
                 窗口标题栏已经写着应用名，栏内再重复一次是冗余；
                 去掉后导航项整体上移，与右侧页标题的基线更贴近。 -->
            <Border Grid.Column="0" Background="{StaticResource NavBg}"
                    BorderBrush="{StaticResource LineEdge}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,14,0,0">
                    <RadioButton x:Name="NavMenuStyle"  Content="菜单样式"  GroupName="Nav" IsChecked="True" Style="{StaticResource NavItemStyle}"/>
                    <RadioButton x:Name="NavOperation"  Content="操作配置"  GroupName="Nav" Style="{StaticResource NavItemStyle}"/>
                    <RadioButton x:Name="NavXuanKongSi" Content="悬空寺"    GroupName="Nav" Style="{StaticResource NavItemStyle}"/>
                    <RadioButton x:Name="NavMisc"       Content="杂项设置"  GroupName="Nav" Style="{StaticResource NavItemStyle}"/>
                </StackPanel>
            </Border>

            <!-- 右侧内容区：用 TabControl 承载四个页面，但把标签栏藏掉，
                 由左侧导航通过 IsChecked 驱动 SelectedIndex（代码里补绑定）。 -->
            <Grid Grid.Column="1">
                <TabControl Name="MainTabControl" BorderThickness="0" Background="Transparent"
                            Padding="0" Margin="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 标签条保留但高度为 0：TabItem 必须被 ItemsPresenter 实体化，
                                         SelectedContent 才有内容可呈现。直接删掉 ItemsPresenter
                                         会让整个内容区变成空白（且不报错，很难查）。 -->
                                    <RowDefinition Height="0"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ItemsPresenter Grid.Row="0" x:Name="HeaderPanel"/>
                                <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- ========== 页 1：菜单样式 ==========
                         参照 PixPin 重排：整页**一张白卡 + 行流**。
                         每组内容用 GroupHeaderStyle 小标题分隔，组内每行左右两端对齐，
                         行与行之间夹一条 RowSeparator 淡线 —— 整齐感全部来自这条线。
                         ⚠️ Name 全部保留不变，SettingsWindow.xaml.cs 按名字读写控件与切可见性。 -->
                    <TabItem Header="菜单样式">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,20" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="菜单样式" Style="{StaticResource PageTitleStyle}"/>

                                <!-- 卡片 1：全部配置项 -->
                                <Border Style="{StaticResource GroupBorder}">
                                    <StackPanel>

                                        <!-- ── 组：样式选择 ──
                                             注意：这里的 IsChecked 只是设计期的初始状态，
                                             运行时一律由 PopulateUIFromConfig() 按配置覆盖。
                                             当前程序默认样式是 Headshot，所以初始勾它。 -->
                                        <TextBlock Text="样式" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,4,0,12"/>
                                        <Grid Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Name="BasicRadialRadio" Content="圆环"
                                                             Margin="0,0,24,0" VerticalAlignment="Center"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton Name="CSHeadshotRadio" Content="Headshot" IsChecked="True"
                                                             Margin="0,0,24,0" VerticalAlignment="Center"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton Name="SpiderWebRadio" Content="蜘蛛网"
                                                             Margin="0,0,24,0" VerticalAlignment="Center"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton Name="BaguaRadio" Content="八卦"
                                                             VerticalAlignment="Center"
                                                             Style="{StaticResource RadioStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- ── 组：圆环参数（圆环样式时显示） ── -->
                                        <StackPanel Name="BasicRadialConfigGrid">
                                            <Border Style="{StaticResource RowSeparator}" Margin="0,12,0,0"/>
                                            <TextBlock Text="尺寸" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,4"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="外半径" Style="{StaticResource LabelStyle}"
                                                           ToolTip="单位：逻辑像素（100% 缩放基准）。实际显示会按屏幕缩放比例自动放大。"/>
                                                <TextBox Grid.Column="1" Name="BasicOuterRadiusBox" Text="50"
                                                         Style="{StaticResource InputStyle}"
                                                         ToolTip="单位：逻辑像素（100% 缩放基准）。实际显示会按屏幕缩放比例自动放大。"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowSeparator}"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="内半径" Style="{StaticResource LabelStyle}"
                                                           ToolTip="单位：逻辑像素（100% 缩放基准）。决定中心死区大小。"/>
                                                <TextBox Grid.Column="1" Name="BasicInnerRadiusBox" Text="28"
                                                         Style="{StaticResource InputStyle}"
                                                         ToolTip="单位：逻辑像素（100% 缩放基准）。"/>
                                            </Grid>

                                            <!-- 配色（同属圆环，不再单开卡片） -->
                                            <Border Style="{StaticResource RowSeparator}" Margin="0,12,0,0"/>
                                            <TextBlock Text="配色" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,2"/>

                                            <!-- ⚠️ 色值文本框 Name="Basic...ColorBox" 仍在，但**界面不可见**。
                                                 它是这个颜色的真值载体：配置读写、格式校验、
                                                 预览重绘全挂在它上面（代码里约 10 处引用）。
                                                 删控件会牵动整套逻辑，所以选择「留在树上但不显示」——
                                                 Width/Height 归零 + Collapsed，不占任何布局空间。

                                                 色值改由按钮文字承担：按钮 Content 绑到文本框 Text，
                                                 于是「色块 + #RRGGBB」在同一个按钮里表达。
                                                 取色器里也照样能看到当前色值（HEX/RGB/HSV/HSL 四格式）。 -->
                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="圆环颜色" Style="{StaticResource LabelStyle}"/>
                                                <Button Grid.Column="1" Name="BasicRingColorPickButton"
                                                        Style="{StaticResource ColorSwatchButton}"
                                                        Content="{Binding ElementName=BasicRingColorBox, Path=Text}"
                                                        Tag="{Binding ElementName=BasicRingColorBox, Path=Text}"/>
                                                <TextBox Grid.Column="2" Name="BasicRingColorBox" Text="#FFFFFF"
                                                         Width="0" Height="0" Visibility="Collapsed"
                                                         IsTabStop="False" Focusable="False"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowSeparator}"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="高亮颜色" Style="{StaticResource LabelStyle}"/>
                                                <Button Grid.Column="1" Name="BasicHighlightColorPickButton"
                                                        Style="{StaticResource ColorSwatchButton}"
                                                        Content="{Binding ElementName=BasicHighlightColorBox, Path=Text}"
                                                        Tag="{Binding ElementName=BasicHighlightColorBox, Path=Text}"/>
                                                <TextBox Grid.Column="2" Name="BasicHighlightColorBox" Text="#007AFF"
                                                         Width="0" Height="0" Visibility="Collapsed"
                                                         IsTabStop="False" Focusable="False"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- 兼容：原独立配色卡片名，代码按 isBasic 切它的可见性 -->
                                        <Border Name="BasicColorCard" Height="0" Visibility="Collapsed"/>

                                        <!-- ── 组：Headshot（八角星造型；选中 Headshot 时显示） ── -->
                                        <StackPanel Name="CSHeadshotConfigGrid" Visibility="Collapsed">
                                            <Border Style="{StaticResource RowSeparator}" Margin="0,14,0,0"/>
                                            <TextBlock Text="大小" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,2"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="缩放" Style="{StaticResource LabelStyle}"
                                                           ToolTip="100% = 基准大小（100% 缩放下的逻辑像素）。实际显示还会按屏幕缩放比例自动放大。"/>
                                                <Slider Grid.Column="1" Name="CSHeadshotScaleSlider"
