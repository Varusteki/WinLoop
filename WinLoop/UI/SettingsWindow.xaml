                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="半径" Style="{StaticResource LabelStyle}"
                                                           ToolTip="单位：逻辑像素（100% 缩放基准）。实际显示会按屏幕缩放比例自动放大。"/>
                                                <TextBox Grid.Column="1" Name="BaguaRadiusBox" Text="90"
                                                         Style="{StaticResource InputStyle}"
                                                         ToolTip="单位：逻辑像素（100% 缩放基准）。"/>
                                            </Grid>

                                            <Border Style="{StaticResource RowSeparator}" Margin="0,12,0,0"/>
                                            <TextBlock Text="外观" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,2"/>

                                            <Grid Style="{StaticResource SettingRow}">
