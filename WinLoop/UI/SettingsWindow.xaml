                    </TabItem>

                    <!-- ========== 页 2：操作配置 ==========
                         三栏布局：左列 4 行 + 中间菜单 + 右列 4 行。
                         8 个选区**同时**列出（不再是"点一个看一个"），
                         参数区与菜单在同一屏内，不需要下滑。

                         左右分组按扇区方位定：Position1~4（上/右上/右/右下）在右列，
                         Position5~8（下/左下/左/左上）在左列 —— 这样每个扇区的引线
                         都朝自己那一侧引出，8 条线天然不交叉。
                         列内顺序也按方位排（右列自上而下 上→右下，左列自上而下 左上→下），
                         保证行的上下次序与扇区的上下次序一致，线不会互穿。

                         ⚠️ 行内**刻意不写**「位置N · 方位」文字（2026-09-22 用户要求去掉）；
                         卡片顶部也没有「扇区动作」组标题。行与扇区的对应关系**只由引线表达** ——
                         所以引线是这一页唯一的信息骨架，不是装饰。

                         ⚠️ 引线不在 XAML 里 —— 它要跨三栏画，且依赖运行时布局尺寸，
                         由 UpdateOpConnectors() 画在 OpConnectorLayer 上（IsHitTestVisible=False）。
                         ⚠️ 三个 Canvas/StackPanel 的 Name 与 8 个行的 Name 都被
                         SettingsWindow.xaml.cs 按名字索引，改名要同步改代码。 -->
                    <TabItem Header="操作配置">
                        <!-- ⚠️ 这一页的 ScrollViewer **故意不加** VerticalAlignment="Top"：
                             它必须撑满整页高度，下面的卡片才能靠 MinHeight = 视口高顶满整页
                             （代码里由 SyncOpPageCardHeight 同步，见 SettingsWindow.xaml.cs）。
                             卡片若只按内容高度排，就只在页面顶部占一条、下面空一大片 ——
                             用户 2026-09-22 反馈的"面板在整个设置窗口吊着"正是这个。 -->
                        <ScrollViewer Name="OpPageScroll" VerticalScrollBarVisibility="Auto"
                                      Padding="24,20,24,20">
                            <!-- ⚠️ 这一页**刻意没有**页面大标题（2026-09-22 用户要求去掉）：
                                 左侧导航已写着「操作配置」，标题只是重复。
                                 整页就这一张卡，Margin 置 0 —— GroupBorder 自带 12 的底边距，
                                 叠上去会超出视口，反而逼出一条多余的滚动条。 -->
                            <Border Name="OpPageCard" Style="{StaticResource GroupBorder}" Margin="0">
                                <!-- ⚠️ 卡片顶部**刻意没有**「扇区动作」小标题与分割线
                                     （2026-09-22 用户要求删）：左边导航已经写着「操作配置」，
                                     卡里再顶一行组名是重复的一层层级，白占纵向空间。 -->
                                <Grid Name="OpLayoutGrid" Margin="0,0,0,2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <!-- 186→150（2026-09-22 用户"配置选项适当调小点"）：
                                             列让窄 → 行的朝内边缘离菜单中心更远 → 中间的菜单
                                             能把这一列的空间用满（不再被固定系数 0.72 缩小，
                                             见 ComputeOpFitCap），长下拉框也仍放得下。
                                             150 = 下拉框 134 + 行内边距 8×2，最长动作名仍放得下。 -->
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                            <!-- ── 左列：左半侧扇区（左上 / 左 / 左下 / 下）──
                                                 行内只有一个动作下拉框，**不写**位置文字 —— 行与扇区的
                                                 对应全靠引线（否则文字是重复信息，还把行撑高、
                                                 让引线起点上下飘）。 -->
                                            <!-- 左列＝位置8/7/6/5（从上到下），要让它**整体下移 9px**：
                                                 top=+18 使元素下移 9px，bottom=−10 抵消末尾行距。
                                                 下移后第 4 行（位置5 正下）行心 = +99 = 锚点 y → 一段直线。
                                                 见 OpRowStyle 上方注释的 ②。 -->
                                            <StackPanel Name="OpLeftList" Grid.Column="0" VerticalAlignment="Center"
                                                        Margin="0,18,0,-10">
                                                <Border Name="OpRowP8" Style="{StaticResource OpRowStyle}">
                                                    <ComboBox Name="OpComboP8" Tag="7" Style="{StaticResource OpComboStyle}"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="OpActionCombo_SelectionChanged"/>
                                                </Border>
                                                <Border Name="OpRowP7" Style="{StaticResource OpRowStyle}">
                                                    <ComboBox Name="OpComboP7" Tag="6" Style="{StaticResource OpComboStyle}"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="OpActionCombo_SelectionChanged"/>
                                                </Border>
                                                <Border Name="OpRowP6" Style="{StaticResource OpRowStyle}">
                                                    <ComboBox Name="OpComboP6" Tag="5" Style="{StaticResource OpComboStyle}"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="OpActionCombo_SelectionChanged"/>
                                                </Border>
                                                <Border Name="OpRowP5" Style="{StaticResource OpRowStyle}">
                                                    <ComboBox Name="OpComboP5" Tag="4" Style="{StaticResource OpComboStyle}"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="OpActionCombo_SelectionChanged"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- ── 中间：菜单本身（点击扇区即选中该选区的配置行）──
                                                 ⚠️ 这一页的菜单是**示意图**：尺寸不是要展示的信息
                                                 （真实尺寸看「菜单样式」页的衍生预览窗口），
                                                 职责是把中间这列的空间用满、当好引线的锚点环 ——
                                                 所以按可用空间尽量画大，并且**允许放大**
                                                 （与「菜单样式」页"只缩小不放大"的规则不同）。
                                                 约束只剩两条：画布装得下、锚点环 + 选中态圆点
                                                 不许越进行的内边缘（后者按**实测**反解，
                                                 见 SettingsWindow.xaml.cs 的 ComputeOpFitCap）。 -->
                                            <Canvas Name="OpPreviewCanvas" Grid.Column="1"
                                                    Width="252" Height="252"
                                                    Background="#00000000"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    MouseLeftButtonDown="OpPreviewCanvas_MouseLeftButtonDown"/>

                                            <!-- ── 右列：右半侧扇区（上 / 右上 / 右 / 右下）── -->
                                            <!-- 右列＝位置1/2/3/4（从上到下），要让它**整体上移 9px**：
                                                 bottom=+8 使元素上移 9px（含抵消末尾行距的 −10 基准）。
                                                 上移后第 1 行（位置1 正上）行心 = −99 = 锚点 y → 一段直线。
                                                 见 OpRowStyle 上方注释的 ②。 -->
                                            <!-- 右列＝位置1/2/3/4（从上到下），要让它**整体上移 9px**：
                                                 bottom=+8 使元素上移 9px（含抵消末尾行距的 −10 基准）。
                                                 上移后第 1 行（位置1 正上）行心 = −99 = 锚点 y → 一段直线。
                                                 见 OpRowStyle 上方注释的 ②。 -->
                                            <StackPanel Name="OpRightList" Grid.Column="2" VerticalAlignment="Center"
                                                        Margin="0,0,0,8">
                                                <Border Name="OpRowP1" Style="{StaticResource OpRowStyle}">
                                                    <ComboBox Name="OpComboP1" Tag="0" Style="{StaticResource OpComboStyle}"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="OpActionCombo_SelectionChanged"/>
                                                </Border>
                                                <Border Name="OpRowP2" Style="{StaticResource OpRowStyle}">
                                                    <ComboBox Name="OpComboP2" Tag="1" Style="{StaticResource OpComboStyle}"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="OpActionCombo_SelectionChanged"/>
                                                </Border>
                                                <Border Name="OpRowP3" Style="{StaticResource OpRowStyle}">
                                                    <ComboBox Name="OpComboP3" Tag="2" Style="{StaticResource OpComboStyle}"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="OpActionCombo_SelectionChanged"/>
                                                </Border>
                                                <Border Name="OpRowP4" Style="{StaticResource OpRowStyle}">
                                                    <ComboBox Name="OpComboP4" Tag="3" Style="{StaticResource OpComboStyle}"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="OpActionCombo_SelectionChanged"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- ── 引线层 ──
                                                 铺满三栏、压在最上层，但 IsHitTestVisible=False：
                                                 它只负责把每行连到菜单里对应的扇区，不参与任何交互
                                                 （否则会挡住左右列的 ComboBox 点击与悬停）。
                                                 引线画在**行的朝内边缘之外**，不进入行内，所以不会盖住行内容。 -->
                                            <Canvas Name="OpConnectorLayer" Grid.ColumnSpan="3"
                                                    IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========== 页 3：悬空寺 ========== -->
                    <TabItem Header="悬空寺">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,20" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="悬空寺" Style="{StaticResource PageTitleStyle}"/>

                                <Border Style="{StaticResource GroupBorder}">
                                    <StackPanel>
                                        <TextBlock Text="触发与内容" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,4,0,14"/>

                                        <CheckBox Name="XuanKongSiEnabledCheck" Content="启用悬空寺"
                                                  IsChecked="True" Margin="0,2,0,10"
                                                  Style="{StaticResource CheckStyle}"/>

                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="触发按键" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox Grid.Column="1" Name="XuanKongSiKeyCombo" Style="{StaticResource ComboStyle}"
                                                      Width="200" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowSeparator}"/>

                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="展示内容" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox Grid.Column="1" Name="XuanKongSiContentCombo" Style="{StaticResource ComboStyle}"
                                                      Width="200" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowSeparator}"/>

                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="操作提示" Style="{StaticResource LabelStyle}"/>
                                            <TextBlock Grid.Column="1" Name="XuanKongSiOperationHintText"
                                                       Foreground="{StaticResource TextSub}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowSeparator}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 文字内容面板：与图片面板互斥显示 -->
                                <Border Style="{StaticResource GroupBorder}" Name="XuanKongSiTextPanel" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="文字内容（Markdown）" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,4,0,14"/>
                                        <TextBox Name="XuanKongSiTextEditor" Style="{StaticResource InputFillStyle}" Height="200"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>

                                <!-- 图片面板 -->
                                <Border Style="{StaticResource GroupBorder}" Name="XuanKongSiImagePanel" Visibility="Visible" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="图片" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,4,0,14"/>
                                        <Button Name="XuanKongSiPickImageButton" Content="选择图片" Width="104"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource SecondaryButton}"/>

                                        <!-- 图片预览：宽度跟随卡片可用宽度，等比缩放（Stretch=Uniform）
                                             保证完整可见、高度按原始宽高比自适应。
                                             无论用户选了图还是走默认图，都会展示 —— 用户要能
                                             直接看到"现在实际会显示什么"。 -->
                                        <Border Name="XuanKongSiImagePreviewBorder"
                                                Margin="0,14,0,0" Padding="10"
                                                Background="#FFFAFAFA"
                                                BorderBrush="{StaticResource LineEdge}" BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="Collapsed">
                                            <Image Name="XuanKongSiImagePreview"
                                                   Stretch="Uniform"
                                                   StretchDirection="DownOnly"
                                                   HorizontalAlignment="Center"
                                                   SnapsToDevicePixels="True"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========== 页 4：杂项设置 ========== -->
                    <TabItem Header="杂项设置">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,20" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="杂项设置" Style="{StaticResource PageTitleStyle}"/>

                                <Border Style="{StaticResource GroupBorder}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="启动与行为" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,4,0,14"/>

                                        <CheckBox Name="AutoStartCheck" Content="开机自动启动" IsChecked="True"
                                                  Margin="0,2,0,10" Style="{StaticResource CheckStyle}"/>
                                        <CheckBox Name="MinimizeToTrayCheck" Content="最小化到托盘" IsChecked="True"
                                                  Margin="0,0,0,8" Style="{StaticResource CheckStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}"/>

                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="触发时长" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Grid.Column="1" Name="TriggerDelayBox" Text="200"
                                                     Style="{StaticResource InputStyle}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- 底部操作栏：参照 PixPin 的三段式布局。
             - 左侧：「恢复所有默认设置」——破坏性操作，用弱化的危险色描边，离主按钮远一点；
             - 中间：状态提示（已修改 / 已保存），gives 用户"改没改"的即时反馈；
             - 右侧：取消 + 确定，确定是主按钮。
             ⚠️ SaveButton / RestoreDefaultsButton 这两个 Name 被 SettingsWindow.xaml.cs
             的构造函数直接绑定事件，改名会静默失去响应，必须保留。 -->
        <Border Grid.Row="1" Background="{StaticResource FooterBg}"
                BorderBrush="{StaticResource LineEdge}" BorderThickness="0,1,0,0"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="RestoreDefaultsButton" Content="恢复所有默认设置"
                        MinWidth="150" Style="{StaticResource DangerGhostButton}"/>

                <TextBlock Grid.Column="1" x:Name="FooterStatusText" Text=""
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Style="{StaticResource HintStyle}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="取消" Width="94" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"/>
                    <Button Name="SaveButton" Content="确定" Width="94" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
