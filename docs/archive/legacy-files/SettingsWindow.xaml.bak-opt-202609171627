<Window x:Class="WinLoop.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinLoop.UI"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"    Title="WinLoop 设置" Width="760" Height="560" MinWidth="680" MinHeight="480" FontSize="13.5" FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 把 "#RRGGBB" 字符串转成 Brush，供色块按钮的填充色绑定。
             绑定不会自动走类型转换器，必须显式转一次；
             转不出来（用户敲了半截）就退回透明，不要抛异常砸掉整个界面。 -->
        <local:HexToBrushConverter x:Key="HexToBrush"/>
        <!-- ==================== 设计令牌 ====================
             跟随 Windows 浅色主题取色，集中在这里定义：改配色只改这一段，全局生效。
             原先散落在各处的 #FFE3E3E3 / #FFF7F7F7 / #FF444444 / #888 全部收敛到这里。 -->

        <!-- 底色层次：窗口 > 导航区 > 卡片
             参照 PixPin：导航底色比内容区**更浅**（#F7F7F7 vs #F5F5F5），
             靠"更亮"而不是"更深"来区分区域，视觉上更透气。 -->
        <SolidColorBrush x:Key="WindowBg"      Color="#FFF5F5F5"/>
        <SolidColorBrush x:Key="NavBg"         Color="#FFFAFAFA"/>
        <SolidColorBrush x:Key="CardBg"        Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="FooterBg"      Color="#FFF5F5F5"/>

        <!-- 表单行的分隔线：PixPin 那种"整齐感"主要来自这条线 -->
        <SolidColorBrush x:Key="RowLine"       Color="#FFEDEDED"/>
        <!-- 导航选中态实心块 -->
        <SolidColorBrush x:Key="NavActiveBg"   Color="#FF0F6CBD"/>
        <SolidColorBrush x:Key="NavHoverBg"    Color="#FFEFEFEF"/>

        <!-- 描边：卡片 / 分隔线 / 输入框 -->
        <SolidColorBrush x:Key="LineEdge"       Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="LineSoft"       Color="#FFE8E8E8"/>
        <SolidColorBrush x:Key="InputEdge"      Color="#FFC8C8C8"/>
        <SolidColorBrush x:Key="InputEdgeHot"   Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="InputEdgeOn"    Color="#FF0F6CBD"/>

        <!-- 文字：主 / 次 / 弱 -->
        <SolidColorBrush x:Key="TextMain"      Color="#FF1B1B1B"/>
        <SolidColorBrush x:Key="TextSub"       Color="#FF5A5A5A"/>
        <SolidColorBrush x:Key="TextFaint"     Color="#FF8A8A8A"/>

        <!-- 强调色（Windows 11 系统蓝） -->
        <SolidColorBrush x:Key="Accent"        Color="#FF0F6CBD"/>
        <SolidColorBrush x:Key="AccentHot"     Color="#FF1A7AD1"/>
        <SolidColorBrush x:Key="AccentDown"    Color="#FF0B5AA0"/>
        <SolidColorBrush x:Key="AccentSoft"    Color="#FFE8F1FB"/>

        <!-- 间距令牌（四档） -->
        <sys:Double x:Key="GapXs">4</sys:Double>
        <sys:Double x:Key="GapSm">8</sys:Double>
        <sys:Double x:Key="GapMd">12</sys:Double>
        <sys:Double x:Key="GapLg">20</sys:Double>

        <!-- 表单栅格：标签列与输入列统一宽度，输入框不再左右参差。
             ⚠️ 两类 token 不能混用：
               - Width 用在 TextBox/Border 等 FrameworkElement 上，类型是 double；
               - ColumnWidth 用在 ColumnDefinition.Width 上，类型是 GridLength。
             混用会在**运行时**抛 XamlParseException（编译期查不出来）。

             行高参照 PixPin：控件本体 30 + 行内上下留白 = 行总高 44。
             分割线画在行底，因此每行是"内容 30 + 边距 7+7"，线上的下一行重新开始计数。 -->
        <sys:Double x:Key="FormLabelW">92</sys:Double>
        <sys:Double x:Key="FormFieldW">78</sys:Double>
        <sys:Double x:Key="FormRowH">30</sys:Double>
        <sys:Double x:Key="FormRowPadV">7</sys:Double>
        <GridLength x:Key="FormLabelCol">104</GridLength>
        <!-- 行流模板：标签固定宽 → 控件列 → 剩余（说明文字/弹性空间） -->
        <GridLength x:Key="FormFieldCol">Auto</GridLength>

        <!-- ==================== 文字 ==================== -->

        <!-- 表单行标签：左对齐，垂直居中于行内。行间距由行的 Padding 控制，
             这里不再自带上下 Margin（否则行高会失控）。 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
        </Style>

        <!-- 卡片内的小标题（"尺寸" / "配色" 这类分组名） -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 弱化说明文字（尺寸单位、换算结果等） -->
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 行内右侧的说明文字：垂直居中在控件同一水平线上 -->
        <Style x:Key="RowHintStyle" TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>

        <!-- 独立的页面标题（每页顶部一行，位于白卡**之外**，参照 PixPin） -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- ==================== 行流 ====================
             重构核心：整页由若干等高"行"堆叠而成，行与行之间夹一条 1px 淡分割线。
             PixPin 的整齐感就来自这套节奏 —— 整齐 > 花哨。
             用法：把 SettingRow 当 Grid 用，行内自加列定义。 -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="{StaticResource FormRowH}"/>
            <Setter Property="Margin" Value="0,7"/>
        </Style>

        <!-- 行间分割线：左右各内缩 1px，避免和卡片边框贴死 -->
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource RowLine}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ==================== 输入控件 ==================== -->

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="{StaticResource FormRowH}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputEdgeHot}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputEdgeOn}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ⚠️ 原先这里写了 Margin="0,6"。行距现在统一由 SettingRow 的 Margin 控制，
             样式里再带 Margin 会让"控件高度 + 双重外边距"叠加，
             在行高较紧的地方（如操作配置页）直接把下方提示文字顶到重叠。
             行内一律不给控件加外边距。 -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="{StaticResource FormRowH}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <!-- ==================== 容器 ==================== -->

        <!-- 卡片：白底 + 细描边 + 圆角。
             参照 PixPin —— **一页一张卡**，卡内用行流堆叠，不再每块内容一个卡片。
             内边距左右 20 / 上下 16，正好容下一个 7px 行距的整行。 -->
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 页内小分组标题：卡内换组时用，左侧一条短蓝标，比纯文字标题更有层次 -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>

        <!-- 卡片内的次级分隔块（不带外框，仅用于配色组这类子区域） -->
        <Style x:Key="SubSectionBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFCFCFC"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ==================== 左侧导航 ==================== -->
        <!-- 顶部标签改为左侧纵向导航：标签横向排列在 760 宽里本来就挤，
             挪到左侧后内容区更宽，四个页面也能共用同一套边距。 -->

        <!-- 参照 PixPin：选中态是**整块实心蓝 + 白字**，不是细竖条 + 淡蓝底。
             原因：左边栏只有 168px 宽，靠竖条暗示选中在窄栏里辨识太慢；
             实心块一眼就能定位当前位置，也省掉额外的视觉元素。 -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="10,2">
                            <ContentPresenter Margin="12,0,12,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavActiveBg}"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== 按钮 ==================== -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHot}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHot}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDown}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDown}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFAFAFA"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputEdgeHot}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== 色块按钮 ====================
             参照 PixPin：按钮内部**左侧嵌一个 14×14 小色块**，右边跟文字"更改颜色"。
             原先的写法是"色块按钮"和"颜色文本框"两个等宽元素并排，占地方且不像工具。
             现在合成一个：用户看到的色块就是真实颜色，点整块即调色。

             色块的填充色**绑定到 Tag**，Tag 再绑到同行的文本框 Text，
             这样在文本框里粘贴 #RRGGBB 或走调色盘，色块都会立刻跟着变。
             ⚠️ 绑定不走类型转换器，string → Brush 必须显式用 HexToBrush。 -->

        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Height" Value="{StaticResource FormRowH}"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="点击选择颜色"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource InputEdge}"
                                BorderThickness="1"
                                Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Name="Chip" Width="14" Height="14" CornerRadius="3"
                                        BorderBrush="#33000000" BorderThickness="1"
                                        Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag, Converter={StaticResource HexToBrush}}"/>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputEdgeHot}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF4F4F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部左侧的"恢复所有默认设置"：破坏性操作。
             参照 PixPin 的做法 —— 用淡红描边 + 红字，明确它是"危险"
             但不给它主按钮的视觉重量，避免误点。 -->
        <Style x:Key="DangerGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFE8B4B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="{StaticResource FormRowH}"/>
            <Setter Property="Foreground" Value="#FFC0382F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFDF2F2"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD08A8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFAE6E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 兼容旧引用：原 "..." 小按钮仍在别处使用 -->
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>
    <!-- ==================== 窗口框架：左导航 + 右内容 + 底部操作栏 ====================
         原先把"保存/恢复默认"用 Panel.ZIndex="100" 浮在 TabControl 上方，
         会盖住标签栏；现在改为底部独立一行，加分隔线，不再遮挡。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：参照 PixPin，窄栏 + 应用名 + 实心块选中 -->
            <Border Grid.Column="0" Background="{StaticResource NavBg}"
                    BorderBrush="{StaticResource LineEdge}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock Text="WinLoop" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMain}" Margin="22,18,0,14"/>

                    <RadioButton x:Name="NavMenuStyle"  Content="菜单样式"  GroupName="Nav" IsChecked="True" Style="{StaticResource NavItemStyle}"/>
                    <RadioButton x:Name="NavOperation"  Content="操作配置"  GroupName="Nav" Style="{StaticResource NavItemStyle}"/>
                    <RadioButton x:Name="NavXuanKongSi" Content="悬空寺"    GroupName="Nav" Style="{StaticResource NavItemStyle}"/>
                    <RadioButton x:Name="NavMisc"       Content="杂项设置"  GroupName="Nav" Style="{StaticResource NavItemStyle}"/>
                </StackPanel>
            </Border>

            <!-- 右侧内容区：用 TabControl 承载四个页面，但把标签栏藏掉，
                 由左侧导航通过 IsChecked 驱动 SelectedIndex（代码里补绑定）。 -->
            <Grid Grid.Column="1">
                <TabControl Name="MainTabControl" BorderThickness="0" Background="Transparent"
                            Padding="0" Margin="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 标签条保留但高度为 0：TabItem 必须被 ItemsPresenter 实体化，
                                         SelectedContent 才有内容可呈现。直接删掉 ItemsPresenter
                                         会让整个内容区变成空白（且不报错，很难查）。 -->
                                    <RowDefinition Height="0"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ItemsPresenter Grid.Row="0" x:Name="HeaderPanel"/>
                                <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- ========== 页 1：菜单样式 ==========
                         参照 PixPin 重排：整页**一张白卡 + 行流**。
                         每组内容用 GroupHeaderStyle 小标题分隔，组内每行左右两端对齐，
                         行与行之间夹一条 RowSeparator 淡线 —— 整齐感全部来自这条线。
                         ⚠️ Name 全部保留不变，SettingsWindow.xaml.cs 按名字读写控件与切可见性。 -->
                    <TabItem Header="菜单样式">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18,20,18" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="菜单样式" Style="{StaticResource PageTitleStyle}"/>

                                <!-- 卡片 1：全部配置项 -->
                                <Border Style="{StaticResource GroupBorder}">
                                    <StackPanel>

                                        <!-- ── 组：样式选择 ── -->
                                        <TextBlock Text="样式" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,6,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Name="BasicRadialRadio" Content="圆环" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                                <RadioButton Name="CSHeadshotRadio" Content="八角星" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                                <RadioButton Name="SpiderWebRadio" Content="蜘蛛网" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                                <RadioButton Name="BaguaRadio" Content="八卦" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- ── 组：圆环参数（圆环样式时显示） ── -->
                                        <StackPanel Name="BasicRadialConfigGrid">
                                            <Border Style="{StaticResource RowSeparator}" Margin="0,10,0,0"/>
                                            <TextBlock Text="尺寸" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,2"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="外半径" Style="{StaticResource LabelStyle}"
                                                           ToolTip="单位：逻辑像素（100% 缩放基准）。实际显示会按屏幕缩放比例自动放大。"/>
                                                <TextBox Grid.Column="1" Name="BasicOuterRadiusBox" Text="50"
                                                         Width="{StaticResource FormFieldW}"
                                                         Style="{StaticResource InputStyle}"
                                                         ToolTip="单位：逻辑像素（100% 缩放基准）。实际显示会按屏幕缩放比例自动放大。"/>
                                                <TextBlock Grid.Column="2" Text="逻辑像素 @100%" Style="{StaticResource RowHintStyle}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowSeparator}"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="内半径" Style="{StaticResource LabelStyle}"
                                                           ToolTip="单位：逻辑像素（100% 缩放基准）。决定中心死区大小。"/>
                                                <TextBox Grid.Column="1" Name="BasicInnerRadiusBox" Text="28"
                                                         Width="{StaticResource FormFieldW}"
                                                         Style="{StaticResource InputStyle}"
                                                         ToolTip="单位：逻辑像素（100% 缩放基准）。"/>
                                                <TextBlock Grid.Column="2" Text="逻辑像素 @100%" Style="{StaticResource RowHintStyle}"/>
                                            </Grid>

                                            <TextBlock Name="BasicSizingHint" Margin="0,8,0,0"
                                                       Style="{StaticResource HintStyle}"
                                                       Text="尺寸单位：逻辑像素（100% 缩放基准）。实际显示会按屏幕的缩放比例自动放大，笔记本接 4K 屏也不会变小。"/>

                                            <!-- 配色（同属圆环，不再单开卡片） -->
                                            <Border Style="{StaticResource RowSeparator}" Margin="0,12,0,0"/>
                                            <TextBlock Text="配色" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,2"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="圆环颜色" Style="{StaticResource LabelStyle}"/>
                                                <Button Grid.Column="1" Name="BasicRingColorPickButton" Content="更改颜色"
                                                        Style="{StaticResource ColorSwatchButton}"
                                                        Tag="{Binding ElementName=BasicRingColorBox, Path=Text}"/>
                                                <TextBox Grid.Column="2" Name="BasicRingColorBox" Text="#FFFFFF"
                                                         Width="104" HorizontalAlignment="Left" Margin="12,0,0,0"
                                                         Style="{StaticResource InputStyle}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowSeparator}"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="高亮颜色" Style="{StaticResource LabelStyle}"/>
                                                <Button Grid.Column="1" Name="BasicHighlightColorPickButton" Content="更改颜色"
                                                        Style="{StaticResource ColorSwatchButton}"
                                                        Tag="{Binding ElementName=BasicHighlightColorBox, Path=Text}"/>
                                                <TextBox Grid.Column="2" Name="BasicHighlightColorBox" Text="#007AFF"
                                                         Width="104" HorizontalAlignment="Left" Margin="12,0,0,0"
                                                         Style="{StaticResource InputStyle}"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- 兼容：原独立配色卡片名，代码按 isBasic 切它的可见性 -->
                                        <Border Name="BasicColorCard" Height="0" Visibility="Collapsed"/>

                                        <!-- ── 组：八角星（八角星样式时显示） ── -->
                                        <StackPanel Name="CSHeadshotConfigGrid" Visibility="Collapsed">
                                            <Border Style="{StaticResource RowSeparator}" Margin="0,10,0,0"/>
                                            <TextBlock Text="大小" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,2"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="缩放" Style="{StaticResource LabelStyle}"
                                                           ToolTip="100% = 基准大小（100% 缩放下的逻辑像素）。实际显示还会按屏幕缩放比例自动放大。"/>
                                                <Slider Grid.Column="1" Name="CSHeadshotScaleSlider"
                                                        Minimum="50" Maximum="200" Value="100"
                                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center" Margin="0,0,12,0"
                                                        ToolTip="100% = 基准大小。实际显示还会按屏幕缩放比例自动放大。"/>
                                                <TextBlock Grid.Column="2" Name="CSHeadshotScaleLabel" Text="100%"
                                                           Width="48" Style="{StaticResource LabelStyle}"/>
                                            </Grid>

                                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintStyle}"
                                                       Text="百分比是相对基准大小的缩放；实际显示还会叠加屏幕缩放比例，因此换到高 DPI 屏幕不会变小。"/>
                                        </StackPanel>

                                        <!-- ── 组：蜘蛛网（蜘蛛网样式时显示） ── -->
                                        <StackPanel Name="SpiderWebConfigGrid" Visibility="Collapsed">
                                            <Border Style="{StaticResource RowSeparator}" Margin="0,10,0,0"/>
                                            <TextBlock Text="尺寸" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,2"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="外圈半径" Style="{StaticResource LabelStyle}"
                                                           ToolTip="单位：逻辑像素（100% 缩放基准）。实际显示会按屏幕缩放比例自动放大。"/>
                                                <TextBox Grid.Column="1" Name="SpiderWebRadiusBox" Text="70"
                                                         Width="{StaticResource FormFieldW}" Style="{StaticResource InputStyle}"
                                                         ToolTip="单位：逻辑像素（100% 缩放基准）。"/>
                                                <TextBlock Grid.Column="2" Text="逻辑像素 @100%" Style="{StaticResource RowHintStyle}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowSeparator}"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="圈数" Style="{StaticResource LabelStyle}"/>
                                                <TextBox Grid.Column="1" Name="SpiderWebRingsBox" Text="3"
                                                         Width="{StaticResource FormFieldW}" Style="{StaticResource InputStyle}"/>
                                                <TextBlock Grid.Column="2" Text="层" Style="{StaticResource RowHintStyle}"/>
                                            </Grid>

                                            <Border Style="{StaticResource RowSeparator}" Margin="0,12,0,0"/>
                                            <TextBlock Text="配色" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,2"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="线条颜色" Style="{StaticResource LabelStyle}"/>
                                                <Button Grid.Column="1" Name="SpiderWebLineColorPickButton" Content="更改颜色"
                                                        Style="{StaticResource ColorSwatchButton}"
                                                        Tag="{Binding ElementName=SpiderWebLineColorBox, Path=Text}"/>
                                                <TextBox Grid.Column="2" Name="SpiderWebLineColorBox" Text="#C0C0C0"
                                                         Width="104" HorizontalAlignment="Left" Margin="12,0,0,0"
                                                         Style="{StaticResource InputStyle}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowSeparator}"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="高亮颜色" Style="{StaticResource LabelStyle}"/>
                                                <Button Grid.Column="1" Name="SpiderWebHighlightColorPickButton" Content="更改颜色"
                                                        Style="{StaticResource ColorSwatchButton}"
                                                        Tag="{Binding ElementName=SpiderWebHighlightColorBox, Path=Text}"/>
                                                <TextBox Grid.Column="2" Name="SpiderWebHighlightColorBox" Text="#007AFF"
                                                         Width="104" HorizontalAlignment="Left" Margin="12,0,0,0"
                                                         Style="{StaticResource InputStyle}"/>
                                            </Grid>

                                            <TextBlock Margin="0,10,0,0" Style="{StaticResource HintStyle}"
                                                       Text="尺寸单位：逻辑像素（100% 缩放基准）。实际显示会按屏幕的缩放比例自动放大。"/>
                                        </StackPanel>

                                        <!-- ── 组：八卦（八卦样式时显示） ── -->
                                        <StackPanel Name="BaguaConfigGrid" Visibility="Collapsed">
                                            <Border Style="{StaticResource RowSeparator}" Margin="0,10,0,0"/>
                                            <TextBlock Text="尺寸" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,2"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="半径" Style="{StaticResource LabelStyle}"
                                                           ToolTip="单位：逻辑像素（100% 缩放基准）。实际显示会按屏幕缩放比例自动放大。"/>
                                                <TextBox Grid.Column="1" Name="BaguaRadiusBox" Text="90"
                                                         Width="{StaticResource FormFieldW}" Style="{StaticResource InputStyle}"
                                                         ToolTip="单位：逻辑像素（100% 缩放基准）。"/>
                                                <TextBlock Grid.Column="2" Text="逻辑像素 @100%" Style="{StaticResource RowHintStyle}"/>
                                            </Grid>

                                            <Border Style="{StaticResource RowSeparator}" Margin="0,12,0,0"/>
                                            <TextBlock Text="外观" Style="{StaticResource GroupHeaderStyle}" Margin="0,12,0,2"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="线条颜色" Style="{StaticResource LabelStyle}"/>
                                                <Button Grid.Column="1" Name="BaguaLineColorPickButton" Content="更改颜色"
                                                        Style="{StaticResource ColorSwatchButton}"
                                                        Tag="{Binding ElementName=BaguaLineColorBox, Path=Text}"/>
                                                <TextBox Grid.Column="2" Name="BaguaLineColorBox" Text="#000000"
                                                         Width="104" HorizontalAlignment="Left" Margin="12,0,0,0"
                                                         Style="{StaticResource InputStyle}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowSeparator}"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="选区透明度" Style="{StaticResource LabelStyle}"/>
                                                <TextBox Grid.Column="1" Name="BaguaSectorTransparencyBox" Text="70"
                                                         Width="{StaticResource FormFieldW}" Style="{StaticResource InputStyle}"/>
                                                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource RowHintStyle}"/>
                                            </Grid>
                                            <Border Style="{StaticResource RowSeparator}"/>

                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="高亮透明度" Style="{StaticResource LabelStyle}"/>
                                                <TextBox Grid.Column="1" Name="BaguaHighlightTransparencyBox" Text="0"
                                                         Width="{StaticResource FormFieldW}" Style="{StaticResource InputStyle}"/>
                                                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource RowHintStyle}"/>
                                            </Grid>

                                            <TextBlock Margin="0,10,0,0" Style="{StaticResource HintStyle}"
                                                       Text="尺寸单位：逻辑像素（100% 缩放基准）。实际显示会按屏幕的缩放比例自动放大。"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>

                                <!-- 卡片 2：效果预览。参照 PixPin —— 预览放在表单流末尾，
                                     与配置项同一个滚动容器，不再叠加浮动层。
                                     画布 280×280 是"完整显示"的基准线：半径超过 ~130 逻辑像素
                                     就会被裁切，届时下方自动标注实际缩放比例（B 档）。 -->
                                <Border Style="{StaticResource GroupBorder}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="效果预览" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,6,0,8"/>
                                        <Canvas Name="PreviewCanvas" Background="#00000000"
                                                MinHeight="240" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Width="280" Height="280"/>
                                        <TextBlock Name="PreviewFitLabel" Style="{StaticResource HintStyle}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========== 页 2：操作配置 ==========
                         ⚠️ 本页修掉了「下拉框与提示文字重叠」：根因是 ComboStyle 自带的
                         Margin="0,6" 与提示文字的上边距叠加，现已把行距统一交给行模型。 -->
                    <TabItem Header="操作配置">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18,20,18" VerticalAlignment="Top">
                            <StackPanel Name="OpConfigRoot">
                                <TextBlock Text="操作配置" Style="{StaticResource PageTitleStyle}"/>

                                <Border Style="{StaticResource GroupBorder}">
                                    <StackPanel>
                                        <TextBlock Text="扇区动作" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,6,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 左：可点击的菜单预览 -->
                                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                                <Canvas Name="OpPreviewCanvas" Background="#00000000" Width="220" Height="220"
                                                        MouseLeftButtonDown="OpPreviewCanvas_MouseLeftButtonDown"/>
                                            </StackPanel>

                                            <!-- 右：当前选中扇区的配置 -->
                                            <StackPanel Grid.Column="1" Name="OpSettingsPanel" VerticalAlignment="Top" Margin="0,10,0,0">
                                                <TextBlock Name="CurrentPositionLabel" Text="位置1 (上)" FontSize="14"
                                                           FontWeight="SemiBold" Foreground="{StaticResource TextMain}"
                                                           Margin="0,0,0,14"/>
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="动作" Style="{StaticResource LabelStyle}"/>
                                                    <ComboBox Grid.Column="1" Name="CurrentPositionCombo" Style="{StaticResource ComboStyle}"
                                                              Width="200" HorizontalAlignment="Left"
                                                              SelectionChanged="CurrentPositionCombo_SelectionChanged"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource HintStyle}" Margin="0,18,0,0"
                                                           Text="在左侧预览上点击任一扇区，即可为该方向指定动作。"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========== 页 3：悬空寺 ========== -->
                    <TabItem Header="悬空寺">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18,20,18" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="悬空寺" Style="{StaticResource PageTitleStyle}"/>

                                <Border Style="{StaticResource GroupBorder}">
                                    <StackPanel>
                                        <TextBlock Text="触发与内容" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,6,0,10"/>

                                        <CheckBox Grid.Row="0" Name="XuanKongSiEnabledCheck" Content="启用悬空寺"
                                                  IsChecked="True" Margin="0,0,0,4"/>

                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="触发按键" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox Grid.Column="1" Name="XuanKongSiKeyCombo" Style="{StaticResource ComboStyle}"
                                                      Width="200" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowSeparator}"/>

                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="展示内容" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox Grid.Column="1" Name="XuanKongSiContentCombo" Style="{StaticResource ComboStyle}"
                                                      Width="200" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowSeparator}"/>

                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="操作提示" Style="{StaticResource LabelStyle}"/>
                                            <TextBlock Grid.Column="1" Name="XuanKongSiOperationHintText"
                                                       Foreground="{StaticResource TextSub}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowSeparator}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 文字内容面板：与图片面板互斥显示 -->
                                <Border Style="{StaticResource GroupBorder}" Name="XuanKongSiTextPanel" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="文字内容（Markdown）" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,6,0,10"/>
                                        <TextBox Name="XuanKongSiTextEditor" Style="{StaticResource InputStyle}" Height="200"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>

                                <!-- 图片面板 -->
                                <Border Style="{StaticResource GroupBorder}" Name="XuanKongSiImagePanel" Visibility="Visible" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="键位图" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,6,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Name="XuanKongSiPickImageButton" Content="选择图片" Width="104"
                                                    Style="{StaticResource SecondaryButton}"/>
                                            <TextBlock Name="XuanKongSiImagePathLabel" Text="(默认：小鹤双拼键位图)"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Style="{StaticResource HintStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========== 页 4：杂项设置 ========== -->
                    <TabItem Header="杂项设置">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18,20,18" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="杂项设置" Style="{StaticResource PageTitleStyle}"/>

                                <Border Style="{StaticResource GroupBorder}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="启动与行为" Style="{StaticResource GroupHeaderStyle}"/>
                                        <Border Style="{StaticResource RowSeparator}" Margin="0,6,0,10"/>

                                        <CheckBox Name="AutoStartCheck" Content="开机自动启动" IsChecked="True" Margin="0,4,0,8"/>
                                        <CheckBox Name="MinimizeToTrayCheck" Content="最小化到托盘" IsChecked="True" Margin="0,0,0,8"/>
                                        <Border Style="{StaticResource RowSeparator}"/>

                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource FormLabelCol}"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="触发时长" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Grid.Column="1" Name="TriggerDelayBox" Text="200"
                                                     Width="{StaticResource FormFieldW}" Style="{StaticResource InputStyle}"/>
                                            <TextBlock Grid.Column="2" Text="毫秒" Style="{StaticResource RowHintStyle}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- 底部操作栏：参照 PixPin 的三段式布局。
             - 左侧：「恢复所有默认设置」——破坏性操作，用弱化的危险色描边，离主按钮远一点；
             - 中间：状态提示（已修改 / 已保存），gives 用户"改没改"的即时反馈；
             - 右侧：取消 + 确定，确定是主按钮。
             ⚠️ SaveButton / RestoreDefaultsButton 这两个 Name 被 SettingsWindow.xaml.cs
             的构造函数直接绑定事件，改名会静默失去响应，必须保留。 -->
        <Border Grid.Row="1" Background="{StaticResource FooterBg}"
                BorderBrush="{StaticResource LineEdge}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="RestoreDefaultsButton" Content="恢复所有默认设置"
                        MinWidth="140" Style="{StaticResource DangerGhostButton}"/>

                <TextBlock Grid.Column="1" x:Name="FooterStatusText" Text=""
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Style="{StaticResource HintStyle}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="取消" Width="88" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"/>
                    <Button Name="SaveButton" Content="确定" Width="88" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
